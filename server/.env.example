# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://amanyad8076_db_user:oETaV730Ir9L6kRb@aivisionhub.5avws0q.mongodb.net/?appName=AIVisionHub

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# AI Provider
# "mock" uses the built-in placeholder engine (no external API needed)
# "openai" / "gemini" / custom URL can be wired in via services/aiService.js
AI_PROVIDER=mock
AI_API_KEY=
AI_API_URL=

# OCR (used by document mode)
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_API_URL=

# Uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Client
CLIENT_URL=http://localhost:5173
